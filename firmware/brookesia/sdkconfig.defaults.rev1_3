# ESP32-P4 Rev1.x profile. Keep this overlay after sdkconfig.defaults.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# 250 MHz PSRAM requires Rev3.0 or later.
CONFIG_SPIRAM_SPEED_200M=y
# Run without the ISP pipeline controller, which also disables IPA.
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=n
